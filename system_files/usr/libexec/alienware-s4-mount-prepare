#!/usr/bin/bash
set -euo pipefail

# Run after local-fs.target, not during shutdown. Discover the actual mount
# dependencies instead of shipping installation-specific disk identifiers.
# Runtime copies are rebuilt from the current systemd template on every boot.
readonly template=/usr/lib/systemd/system/systemd-fsck@.service
readonly destination=/run/systemd/system
readonly marker='# Generated by alienware-s4-mount-prepare'
declare -A instances=()

for path in /boot /boot/efi /var/swap; do
    mountpoint="$(findmnt --noheadings --raw --output TARGET --target "$path")"
    mountunit="$(systemd-escape --path --suffix=mount "$mountpoint")"
    dependencies="$(systemctl list-dependencies --plain --all --full --no-pager "$mountunit")"
    while read -r unit; do
        case "$unit" in
            systemd-fsck@*.service)
                [[ "$unit" != */* ]] || exit 1
                instances["$unit"]=1
                ;;
        esac
    done <<< "$dependencies"
done

install -d -m 0755 "$destination"
temporary="$(mktemp)"
trap 'rm -f "$temporary"' EXIT
{
    printf '%s\n' "$marker"
    # Dependency lists cannot be reset by drop-ins. Preserve the full upstream
    # template, removing only poweroff.target from Unit/Conflicts. Keep reboot,
    # halt, kexec, device binding and boot-time fsck behavior unchanged.
    awk '
        /^\[/ { in_unit = ($0 == "[Unit]") }
        in_unit && /^Conflicts=/ {
            sub(/^Conflicts=/, "")
            printf "Conflicts="
            separator = ""
            for (i = 1; i <= NF; i++) {
                if ($i != "poweroff.target") {
                    printf "%s%s", separator, $i
                    separator = " "
                }
            }
            print ""
            next
        }
        { print }
    ' "$template"
} > "$temporary"

for unit in "${!instances[@]}"; do
    target="$destination/$unit"
    if [[ -e "$target" ]] && ! grep -Fxq "$marker" "$target"; then
        printf 'Refusing to overwrite unrelated runtime unit: %s\n' "$unit" >&2
        exit 1
    fi
    install -m 0644 "$temporary" "$target"
done
systemctl daemon-reload

# Fail visibly if a higher-precedence administrator override or a drop-in
# reintroduces the conflict. Do not rewrite administrator configuration.
for unit in "${!instances[@]}"; do
    conflicts="$(systemctl show --value --property=Conflicts "$unit")"
    if [[ " $conflicts " == *' poweroff.target '* ]]; then
        printf 'S4 mount preparation failed: %s still conflicts with poweroff.target\n' "$unit" >&2
        exit 1
    fi
done
printf 'S4 mount preparation complete: %s fsck instance(s)\n' "${#instances[@]}"
