#!/usr/bin/bash
set -euo pipefail

readonly SWAPFILE=/var/swap/hibernation.swap
RESUME_DEVICE=
RESUME_OFFSET=
STAGED_COUNT=0
STAGED_FINALIZER=
NVIDIA_PREPARED=0
DISPLAY_STOPPED=0
PLYMOUTH_STARTED=0
USERS_STOPPED=0

exec 9>/run/alienware-compatible-poweroff.lock
flock -n 9 || exit 0

# Disposable S4 is safe only when the next boot is explicitly forbidden from
# resuming the image that this operation writes.
if ! grep -qw -- noresume /proc/cmdline; then
    logger -t alienware-compatible-poweroff \
        'Rifiuto S4 usa-e-getta: parametro kernel noresume assente'
    printf 'Refusing disposable S4: kernel argument noresume is missing\n' >&2
    exit 1
fi

restore_runtime() {
    trap - ERR
    set +e
    if (( NVIDIA_PREPARED )); then
        /usr/bin/nvidia-sleep.sh resume || true
    fi
    if ! swapon --show=NAME --noheadings | grep -Fxq /dev/zram0; then
        # swapoff può lasciare /dev/zram0 senza una firma swap riutilizzabile.
        # Il restart ricrea dispositivo, firma e attivazione secondo la
        # configurazione di zram-generator.
        systemctl restart systemd-zram-setup@zram0.service || true
    fi
    if (( PLYMOUTH_STARTED )); then
        /usr/bin/plymouth quit --retain-splash || true
        systemctl stop plymouth-poweroff.service || true
    fi
    if (( USERS_STOPPED )); then
        # The previous graphical session was deliberately terminated and
        # cannot be reconstructed. Restore the slice so the display manager
        # can offer a clean login after a failed S4 transition.
        systemctl start user.slice || true
    fi
    if (( DISPLAY_STOPPED )); then
        systemctl start display-manager.service || true
    fi
}
trap restore_runtime ERR

logger -t alienware-compatible-poweroff 'Avvio spegnimento compatibile tramite ACPI S4'

inspect_staged_deployment() {
    local active_state
    local status_json
    local -a active_finalizers=()
    local finalizer

    status_json="$(ostree admin status --json)"
    STAGED_COUNT="$(jq -er '[.deployments[] | select(.staged == true)] | length' \
        <<<"${status_json}")"
    [[ "${STAGED_COUNT}" =~ ^[0-9]+$ ]] || return 1

    if (( STAGED_COUNT > 1 )); then
        printf 'Refusing S4: multiple staged OSTree deployments found (%s)\n' \
            "${STAGED_COUNT}" >&2
        return 1
    fi

    if (( STAGED_COUNT == 0 )); then
        if [[ -e /run/ostree/staged-deployment ]]; then
            printf 'Refusing S4: stale or inconsistent OSTree staged marker found\n' >&2
            return 1
        fi
        STAGED_FINALIZER=none
        return 0
    fi

    if [[ ! -e /run/ostree/staged-deployment ]]; then
        printf 'Refusing S4: staged deployment has no OSTree runtime marker\n' >&2
        return 1
    fi

    for finalizer in \
        ostree-finalize-staged.service \
        bootc-finalize-staged.service; do
        active_state="$(systemctl show --property=ActiveState --value \
            "${finalizer}")"
        case "${active_state}" in
            active|activating|deactivating)
                active_finalizers+=("${finalizer}")
                ;;
        esac
    done

    # A finalizer may complete between the OSTree status read and the systemd
    # state read. Accept that race only after proving that both the staged
    # deployment and its runtime marker have disappeared.
    if (( ${#active_finalizers[@]} == 0 )); then
        status_json="$(ostree admin status --json)"
        STAGED_COUNT="$(jq -er \
            '[.deployments[] | select(.staged == true)] | length' \
            <<<"${status_json}")"
        if [[ "${STAGED_COUNT}" == 0 && \
              ! -e /run/ostree/staged-deployment ]]; then
            STAGED_FINALIZER=none
            return 0
        fi
    fi

    if (( ${#active_finalizers[@]} != 1 )); then
        printf 'Refusing S4: expected one active staged finalizer, found %s\n' \
            "${#active_finalizers[@]}" >&2
        return 1
    fi
    STAGED_FINALIZER="${active_finalizers[0]}"
}

finalize_staged_deployment() {
    local remaining_staged

    (( STAGED_COUNT == 1 )) || return 0

    logger -t alienware-compatible-poweroff \
        "Finalizzazione deployment staged tramite ${STAGED_FINALIZER}"
    systemctl stop "${STAGED_FINALIZER}"

    remaining_staged="$(ostree admin status --json | \
        jq -er '[.deployments[] | select(.staged == true)] | length')"
    if [[ "${remaining_staged}" != 0 || -e /run/ostree/staged-deployment ]]; then
        logger -t alienware-compatible-poweroff \
            'Finalizzazione deployment staged non completata; annullo S4'
        printf 'Refusing S4: staged deployment finalization did not complete\n' >&2
        return 1
    fi
    logger -t alienware-compatible-poweroff 'Deployment staged finalizzato'
}

inspect_staged_deployment

# Il numero dm-X e l'offset fisico non sono stabili tra installazioni o layout.
# L'helper li deriva direttamente dallo swapfile Btrfs.
read -r RESUME_DEVICE RESUME_OFFSET < <(
    /usr/libexec/alienware-swapfile-resume-info "$SWAPFILE"
)

if [[ ! "$RESUME_DEVICE" =~ ^[1-9][0-9]*:[0-9]+$ ]]; then
    logger -t alienware-compatible-poweroff "Dispositivo resume non valido: $RESUME_DEVICE"
    exit 1
fi
if [[ ! "$RESUME_OFFSET" =~ ^[1-9][0-9]*$ ]]; then
    logger -t alienware-compatible-poweroff "Offset resume non valido: $RESUME_OFFSET"
    exit 1
fi
logger -t alienware-compatible-poweroff "Resume dinamico: device=$RESUME_DEVICE offset=$RESUME_OFFSET"

if [[ ${1:-} == --check ]]; then
    printf 'OK: swapfile=%s device=%s offset=%s staged=%s finalizer=%s\n' \
        "$SWAPFILE" "$RESUME_DEVICE" "$RESUME_OFFSET" \
        "$STAGED_COUNT" "$STAGED_FINALIZER"
    exit 0
fi

# La procedura gira come servizio di sistema: può quindi terminare la sessione
# grafica senza interrompere se stessa. Plymouth viene avviato non appena il
# display manager ha rilasciato console e GPU, così copre anche l'eventuale
# finalizzazione OSTree, che può richiedere diversi secondi.
systemctl stop display-manager.service
DISPLAY_STOPPED=1

# Plasma Login can exit before the user compositor has released DRM/the VT.
# Wait at most ten seconds; never kill unrelated sessions or block S4 forever
# for a cosmetic issue. user.slice is still stopped in its normal place below.
logger -t alienware-compatible-poweroff 'Attesa chiusura KWin prima di Plymouth (massimo 10 secondi)'
for ((kwin_wait=0; kwin_wait<100; kwin_wait++)); do
    if ! /usr/bin/pgrep -x kwin_wayland >/dev/null; then
        break
    fi
    sleep 0.1
done
if /usr/bin/pgrep -x kwin_wayland >/dev/null; then
    logger -t alienware-compatible-poweroff 'Timeout attesa KWin: proseguo con Plymouth e S4'
else
    logger -t alienware-compatible-poweroff 'KWin terminato: avvio Plymouth'
fi
logger -t alienware-compatible-poweroff \
    "Console prima di Plymouth: $(cat /sys/class/tty/tty0/active 2>/dev/null || true)"
systemctl start plymouth-poweroff.service
PLYMOUTH_STARTED=1
if /usr/bin/plymouth --has-active-vt; then
    logger -t alienware-compatible-poweroff 'Plymouth dichiara VT attiva'
else
    logger -t alienware-compatible-poweroff 'Plymouth non dichiara VT attiva'
fi
logger -t alienware-compatible-poweroff \
    "Console dopo Plymouth: $(cat /sys/class/tty/tty0/active 2>/dev/null || true)"

# The disposable-S4 path deliberately cannot reach final.target/umount.target:
# the Btrfs swapfile must remain available. Finalize an atomic update through
# the active upstream service while Plymouth is already visible. On failure,
# restore_runtime returns the machine to a clean login screen.
finalize_staged_deployment
/usr/bin/journalctl --sync
sync

USERS_STOPPED=1
systemctl stop user.slice

# Libera la zram e ricrea la firma dello swapfile, così l'immagine precedente
# non viene conservata. Al prossimo avvio noresume forza comunque un boot pulito.
if swapon --show=NAME --noheadings | grep -Fxq /dev/zram0; then
    swapoff /dev/zram0
fi
if swapon --show=NAME --noheadings | grep -Fxq "$SWAPFILE"; then
    swapoff "$SWAPFILE"
fi
swapon -p -2 "$SWAPFILE"
sync

printf '%s' 0 > /sys/power/image_size
printf '%s' "$RESUME_DEVICE" > /sys/power/resume
printf '%s' "$RESUME_OFFSET" > /sys/power/resume_offset
printf '%s' platform > /sys/power/disk

NVIDIA_PREPARED=1
/usr/bin/nvidia-sleep.sh hibernate
logger -t alienware-compatible-poweroff 'Ingresso in ACPI S4'
printf '%s' disk > /sys/power/state

# Raggiunto soltanto se il firmware restituisce il controllo senza spegnere.
logger -t alienware-compatible-poweroff 'ACPI S4 ha restituito il controllo inaspettatamente'
restore_runtime
exit 1
